# Copy to .env in the repository root. Keep secrets out of Git and chat.
APP_ENV=development
DEMO_MODE=true
DEMO_TOKEN=local-rescueloop-demo
DATABASE_URL=postgresql+psycopg://rescueloop:rescueloop@127.0.0.1:5432/rescueloop_rebuild
# Optional deployment destination; never replaces the local DATABASE_URL automatically.
# Use the existing Supabase Session pooler PostgreSQL URI, with sslmode=require.
HOSTED_DATABASE_URL=
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
AI_MODE=demo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
MODEL_TIMEOUT_SECONDS=45
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence
SELLER_USER_ID=
# Explicit provider selection: disabled, 360dialog_sandbox, or twilio. No fallback.
WHATSAPP_PROVIDER=disabled
WHATSAPP_MERCHANT_ID=SELLER001
D360_API_KEY=
# Digits-only phone, or the exact business-scoped user ID returned by START.
D360_SANDBOX_RECIPIENT=
D360_RECIPIENT_TYPE=phone
# Random private token of at least 32 characters; never print the full webhook URL.
D360_WEBHOOK_SECRET=
# Twilio remains available only when WHATSAPP_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Copy the actual test number shown by Twilio, formatted as whatsapp:+COUNTRYNUMBER.
TWILIO_WHATSAPP_FROM=
TWILIO_MERCHANT_ID=SELLER001
# Public HTTPS origin only, without a webhook path or secret.
PUBLIC_WEBHOOK_URL=
EVIDENCE_ROOT=.local/rebuild-evidence
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_DIST_DIR=.next-rebuild
