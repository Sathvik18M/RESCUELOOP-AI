{
  "name": "rescueloop-ai",
  "private": true,
  "workspaces": [
    "apps/seller-dashboard"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/seller-dashboard",
    "build": "npm run build --workspace apps/seller-dashboard",
    "typecheck": "npm run typecheck --workspace apps/seller-dashboard",
    "test:e2e": "playwright test",
    "contracts": "openapi-typescript contracts/openapi.json -o apps/seller-dashboard/src/lib/api.generated.ts",
    "format": "prettier --write apps/seller-dashboard/src apps/seller-dashboard/*.ts tests/e2e playwright.config.ts",
    "format:check": "prettier --check apps/seller-dashboard/src apps/seller-dashboard/*.ts tests/e2e playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.10"
  }
}
