  "components": {
    "schemas": {
      "Body_evidence_upload_api_demo_conversations__conversation_id__evidence_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_evidence_upload_api_demo_conversations__conversation_id__evidence_post"
      },
      "CaseView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          },
          "policy_version": {
            "type": "integer",
            "title": "Policy Version"
          },
          "seller_approved": {
            "type": "boolean",
            "title": "Seller Approved"
          },
          "quote_paise": {
            "type": "integer",
            "title": "Quote Paise"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "order_id",
          "conversation_id",
          "kind",
          "status",
          "summary",
          "details",
          "policy_version",
          "seller_approved",
          "quote_paise",
          "expires_at",
          "created_at"
        ],
        "title": "CaseView"
      },
      "CollectionInput": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "CollectionInput"
      },
      "DecisionInput": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "request_details"
            ],
            "title": "Decision"
          },
          "quote_paise": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Quote Paise",
            "default": 0
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "title": "Note",
            "default": ""
          },
          "preparation_days": {
            "type": "integer",
            "maximum": 90.0,
            "minimum": 0.0,
            "title": "Preparation Days",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "DecisionInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandoffInput": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "HandoffInput"
      },
      "MessageInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          },
          "message_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Message Id"
          }
        },
        "type": "object",
        "required": [
          "text",
          "message_id"
        ],
        "title": "MessageInput"
      },
      "PolicyDraftInput": {
        "properties": {
          "instruction": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 5,
            "title": "Instruction"
          }
        },
        "type": "object",
        "required": [
          "instruction"
        ],
        "title": "PolicyDraftInput"
      },
      "PolicyRules": {
        "properties": {
          "return_window_days": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 0.0,
            "title": "Return Window Days",
            "default": 7
          },
          "auto_refund_limit_paise": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Auto Refund Limit Paise",
            "default": 25000
          },
          "pickup": {
            "type": "string",
            "enum": [
              "allowed",
              "approval_required",
              "prohibited"
            ],
            "title": "Pickup",
            "default": "approval_required"
          },
          "engraving_requires_approval": {
            "type": "boolean",
            "const": true,
            "title": "Engraving Requires Approval",
            "default": true
          },
          "cancellation_before_shipping": {
            "type": "boolean",
            "title": "Cancellation Before Shipping",
            "default": true
          },
          "warranty_days": {
            "type": "integer",
            "maximum": 3650.0,
            "minimum": 0.0,
            "title": "Warranty Days",
            "default": 365
          },
          "delivery_fee_paise": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Delivery Fee Paise",
            "default": 0
          },
          "tax_basis_points": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Tax Basis Points",
            "default": 0
